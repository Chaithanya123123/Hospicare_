# Copy to config.env and fill in. Never commit config.env.
PORT=5000
MONGO_URI=
FRONTEND_URL_ONE=http://localhost:5173
FRONTEND_URL_TWO=http://localhost:5174
JWT_SECRET_KEY=
JWT_EXPIRES=7d
COOKIE_EXPIRE=7
# Set to true only when the sites and API are on different https domains
COOKIE_CROSS_SITE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by seedAdmins.js
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
# Exactly 11 digits
ADMIN_PHONE=
# Exactly 13 digits
ADMIN_NIC=
# YYYY-MM-DD
ADMIN_DOB=
# Male or Female
ADMIN_GENDER=
# At least 8 characters
ADMIN_PASSWORD=
